# Copy this file to ".env" for local testing with real services,
# and add the same values in Vercel → Project → Settings → Environment Variables.
# Leave everything empty to run locally in TEST MODE (no real payments, files saved in .data/).

# Supabase → Project Settings → API
SUPABASE_URL=
# The service_role key (or a "secret" key). SERVER ONLY: never put it in public/app.js.
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=wish-media

# Razorpay → Account & Settings → API Keys. Start with rzp_test_ keys, switch to live after KYC.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Price per card in rupees
PRICE_INR=35
