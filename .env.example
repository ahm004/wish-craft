# Copy this file to ".env" for local testing with real services,
# and add the same values in Vercel → Project → Settings → Environment Variables.
# Leave everything empty to run locally in TEST MODE (no real payments, files saved in .data/).

# Supabase → Project Settings → API
SUPABASE_URL=
# The service_role key (or a "secret" key). SERVER ONLY: never put it in public/app.js.
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=wish-media

# Razorpay → Account & Settings → API Keys. Start with rzp_test_ keys, switch to live after KYC.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Price charged per card in rupees (the ₹35 list price minus the ₹5 discount)
PRICE_INR=30
# The usual price, shown crossed out next to it. Set it equal to PRICE_INR to hide the discount.
LIST_PRICE_INR=35

# Cards and their photos are deleted automatically this many days after payment (unpaid cards after 24 hours)
CARD_LIFETIME_DAYS=7

# Secret for the daily clean-up job (/api/cleanup). Use any long random text, e.g. 40 random letters and digits.
# On Vercel, setting this variable is enough: Vercel sends it to the job by itself.
CRON_SECRET=
